# Copy this file to secrets.toml (same folder) and fill in real values.
# secrets.toml must NEVER be committed to git — it's already in .gitignore.
#
# If github_token / github_repo are left unset, the app automatically runs
# in LOCAL MODE and writes JSON files under ./data/ instead — handy for
# testing on Termux before you wire it to your data repo.

# --- GitHub persistence (same pattern as HVMS / Send-Out System) ---
# Use a fine-grained PAT scoped to Contents: read/write on ONE private data repo,
# same approach already used for the HVMS data repo.
github_token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
github_repo = "your-username/orange-lab-qc-data"   # "owner/repo"
github_branch = "main"

# --- Access control ---
qc_access_password = "change-me"

# --- Branches ---
branches = ["La Cité", "Diamond"]
